# /etc/cto-relay/relay.env  (root:root 0644) — non-secret settings only.
# The Supabase REST base for NI Brain (project uaztknnipdxxptrmlxlb). Not a secret.
SUPABASE_URL=<SUPABASE_URL>
# Time zone of the 9am CTO check-in.
CTO_RELAY_TZ=America/New_York
# Web base used to build the map's Log link (vault repo blob URL, main branch).
# From PLAN-v7 Appendix A's Log link (northsideventuresllc-sketch/nv-vault); verify before first deploy.
CTO_RELAY_VAULT_WEB_BASE=https://github.com/northsideventuresllc-sketch/nv-vault/blob/main
# The vault repo over SSH (same source; verify). Each program clones it on its first close-out
# read-back into /var/lib/cto-relay/<cto>/vault, with the read-only deploy key cto-relay-vault-read.
CTO_RELAY_VAULT_REPO_URL=git@github.com:northsideventuresllc-sketch/nv-vault.git
# Optional: outbound HTTPS proxy for Slack and the brain (leave unset for direct egress).
#CTO_RELAY_HTTPS_PROXY=<HTTPS_PROXY_URL>
CTO_RELAY_LOG_LEVEL=info
