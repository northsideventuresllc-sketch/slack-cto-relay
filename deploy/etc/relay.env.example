# /etc/cto-relay/relay.env  (root:root 0644) — non-secret settings only.
# The Supabase REST base for NI Brain (project uaztknnipdxxptrmlxlb). Not a secret.
SUPABASE_URL=<SUPABASE_URL>
# Time zone of the 9am CTO check-in.
CTO_RELAY_TZ=America/New_York
# Web base used to build the map's Log link (vault repo blob URL, main branch).
CTO_RELAY_VAULT_WEB_BASE=<VAULT_WEB_BASE>
# Optional: outbound HTTPS proxy for Slack and the brain (leave unset for direct egress).
#CTO_RELAY_HTTPS_PROXY=<HTTPS_PROXY_URL>
CTO_RELAY_LOG_LEVEL=info
