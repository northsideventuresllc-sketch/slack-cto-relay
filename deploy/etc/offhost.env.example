# /etc/cto-relay/offhost.env (root:root 0600) — nightly off-host copy settings. No secrets.
# SSH destination on the mini: the copy user's login + the mini's hostname (C1-FU-3).
# Find it ON THE MINI: `whoami` (as the copy user) and `scutil --get LocalHostName` → <user>@<name>.local
MINI_SSH_DEST=<MINI_SSH_DEST>
# The VM's SSH key for the mini copy user (created at failover setup; public half in the mini user's authorized_keys).
MINI_SSH_KEY=/etc/cto-relay/offhost-ssh-key
# Where the copies land on the mini (the mini programs' state dirs read them at takeover).
MINI_STATE_ROOT=/var/lib/cto-relay
# Local vault checkout (root-owned) that the nightly job commits into, using the write deploy key.
VAULT_DIR=/var/lib/cto-relay/vault-filing
# Vault folders, relative to VAULT_DIR (C1-FU-2). New folders for the loop; Muse CTO may rename them.
VAULT_MIRROR_PATH=_AI/CTO Loop/Mirror
VAULT_ARCHIVE_PATH=_AI/CTO Loop/Brain Archive
# The vault repo over SSH (PLAN-v7 Appendix A's repo; verify). Cloned into VAULT_DIR on first run with the write key.
VAULT_REPO_URL=git@github.com:northsideventuresllc-sketch/nv-vault.git
