# /etc/cto-relay/offhost.env (root:root 0600) — nightly off-host copy settings.
# SSH destination on the mini (key-based ssh as a dedicated copy user; key path below).
MINI_SSH_DEST=<MINI_SSH_USER>@<MINI_HOST>
MINI_SSH_KEY=/etc/cto-relay/offhost-ssh-key
# Where the copies land on the mini (the mini programs' state dirs read them at takeover).
MINI_STATE_ROOT=/var/lib/cto-relay
# Local vault checkout where backups/<date>.sha256 is written and committed.
VAULT_DIR=<VAULT_CHECKOUT_DIR>
