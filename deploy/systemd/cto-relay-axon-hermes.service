# /etc/systemd/system/cto-relay-axon-hermes.service
# Slack CTO Loop relay — AXON-Hermes CTO. One of four separate services (PLAN-v7 D6):
# shared code, separate process, separate service user, separate keys, queue and journal.
#
# Keys (D7): ExecStartPre runs /usr/local/bin/cto-relay-fetch-keys axon-hermes as root on EVERY
# start; it fetches fresh from the Secure Vault into tmpfs /run/credentials/cto-relay-axon-hermes/
# (dir 0500, files 0400, owner cto-relay-axon-hermes) and the process reads them from there
# (CTO_RELAY_KEY_DIR). Files:
#   slack-app-token  (Socket Mode app-level token)
#   slack-bot-token  (bot token)
# No key value ever appears in this file.

[Unit]
Description=Slack CTO Loop relay — AXON-Hermes CTO
Documentation=file:///opt/cto-relay/docs/RELAY-RUNBOOK.md
After=network-online.target cto-relay-muse.service
Wants=network-online.target cto-relay-muse.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=cto-relay-axon-hermes
Group=cto-relay-axon-hermes
SupplementaryGroups=cto-relay-admin
EnvironmentFile=/etc/cto-relay/relay.env
Environment=CTO_RELAY_CTO=axon-hermes
Environment=CTO_RELAY_KEY_DIR=/run/credentials/cto-relay-axon-hermes
Environment=CTO_RELAY_STATE_DIR=/var/lib/cto-relay/axon-hermes
Environment=CTO_RELAY_RUN_DIR=/run/cto-relay
Environment=CTO_RELAY_HOLDER=vm
# Each program reads back close-out logs from its own vault checkout (git fetch, read-only use).
Environment=CTO_RELAY_VAULT_DIR=/var/lib/cto-relay/axon-hermes/vault
ExecStartPre=+/usr/local/bin/cto-relay-fetch-keys axon-hermes
ExecStart=/usr/bin/node /opt/cto-relay/dist/index.js run
ExecStopPost=+/usr/local/bin/cto-relay-fetch-keys --wipe axon-hermes
# Fail-closed: brain down / lease held elsewhere → exit 1 → retried every 30 s.
# Exit 78 = stay down (revoked token, Socket Mode reconnects exhausted, config placeholders) → alert, no restart.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=78

StateDirectory=cto-relay/axon-hermes
StateDirectoryMode=0700
# /run/cto-relay/<cto> (control socket) and /run/cto-relay/broker come from
# /etc/tmpfiles.d/cto-relay.conf so the broker and admin groups can reach them.
UMask=0077

# Isolation envelope (D6): MemoryMax=128M, CPUQuota=25%. The program's own watchdog
# alerts and exits on >50% CPU sustained 5 minutes.
MemoryMax=128M
CPUQuota=25%

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/cto-relay/axon-hermes /run/cto-relay
ReadOnlyPaths=/opt/cto-relay /etc/cto-relay/relay.env

[Install]
WantedBy=multi-user.target
