{
  "name": "slack-cto-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Slack CTO Loop relay: one program per CTO (Muse, Claude, Gemini, AXON-Hermes).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cto-relay": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint:secrets": "bash scripts/check-no-secrets.sh",
    "check": "npm run typecheck && npm test && npm run lint:secrets"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.1.1",
    "@slack/web-api": "^8.3.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
